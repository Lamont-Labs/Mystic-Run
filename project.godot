; Mystic Run: a playable Android runner with Knight, Gargoyle and Witch.
; Open this project in the pinned Godot editor and run scenes/main.tscn.
config_version=5

[application]
config/name="Mystic Run"
config/version="0.6.1"
config/icon="res://assets/icon.svg"
boot_splash/bg_color=Color(0.188,0.141,0.349,1)
boot_splash/show_image=false
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]
pointing/emulate_touch_from_mouse=false
sensors/enable_gravity=true
sensors/enable_accelerometer=true

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
