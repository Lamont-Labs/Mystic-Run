local runner=require("main.runner")
local knight=require("main.knight")
local GOLD=vmath.vector4(.94,.77,.43,1)
local WHITE=vmath.vector4(.96,.95,.91,1)
local INK=vmath.vector4(.055,.09,.17,.94)
local function color(r,g,b,a) return vmath.vector4(r,g,b,a or 1) end
local function box(x,y,w,h,texture,layer,tint)
    local n=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0))
    gui.set_layer(n,layer or "hud")
    if texture then
        gui.set_texture(n,texture=="vista" and "environment" or "art");gui.play_flipbook(n,texture)
        gui.set_size_mode(n,gui.SIZE_MODE_MANUAL)
        gui.set_size(n,vmath.vector3(w,h,0))
    end
    if tint then gui.set_color(n,tint) end
    return n
end
local function text(x,y,value,size,font,layer,tint)
    local n=gui.new_text_node(vmath.vector3(x,y,0),value)
    gui.set_font(n,font or "ui");gui.set_layer(n,layer or "hud")
    gui.set_scale(n,vmath.vector3(size/32,size/32,1))
    gui.set_color(n,tint or WHITE)
    gui.set_shadow(n,vmath.vector4(0,0,0,.65))
    return n
end
local function projection(z)
    local p=1/(1+math.max(-8,z)*.06)
    return 795-535*p,80+760*p,p
end
local function bridge(self,state)
    if not self.web then return end
    local payload={type="mysticrun-state",state=state or self.s.mode,
        distance=math.floor(self.s.distance),coins=self.s.coins,
        hp=self.s.hp,height=self.s.height,lane=self.s.lane,x=self.s.x,
        crouch=self.s.crouch,jumps=self.s.jumps,slides=self.s.slides,
        attacks=self.s.attacks,hits=self.s.hits,frames=self.frames,
        mean_frame_ms=self.frames>0 and self.frame_total/self.frames*1000 or 0,
        max_frame_ms=self.max_frame*1000}
    local encoded=json.encode(payload)
    html5.run("window.__MYSTICRUN_STATE="..encoded..";window.parent.postMessage("..
        encoded..",window.location.origin);")
end
local function command(self,c)
    runner.command(self.s,c)
    bridge(self)
end
function init(self)
    if sys.get_config_int("prototype.smoke",0)==1 then
        self.smoke=true
        require("tests.runner_checks").run()
        timer.delay(.1,false,function() sys.exit(0) end)
        return
    end
    msg.post(".","acquire_input_focus")
    self.web=sys.get_sys_info().system_name=="HTML5"
    self.s=runner.new()
    self.frames=0;self.frame_total=0;self.max_frame=0;self.report=0
    self.sky=box(360,640,1280,1280,"vista","sky")
    box(360,1080,720,400,"veil","sky",color(.15,.18,.30,.60))
    self.road={}
    for i=1,86 do self.road[i]=box(360,0,1,1,"strip_00","road") end
    self.rails={}
    for i=1,30 do
        self.rails[i]={box(0,0,1,1,"rail","road"),box(0,0,1,1,"rail","road")}
    end
    self.pool={}
    for i=1,40 do
        self.pool[i]=box(0,0,1,1,"coin","objects")
        gui.set_enabled(self.pool[i],false)
    end
    self.shadow=box(360,260,134,30,"shadow","hero",color(.08,.07,.16,.5))
    self.actor=knight.new()
    self.particles={}
    for i=1,18 do
        self.particles[i]=box(0,0,4,4,"spark","fx",color(1,.86,.48,.7))
    end
    box(360,1180,672,132,"panel","hud",INK)
    text(360,1224,"CASTLE HEIGHTS",24,"title","hud",GOLD)
    self.distance=text(128,1170,"0 m",35,"title")
    self.coins=text(362,1170,"0 relics",25)
    self.health=text(588,1170,"3 / 3",25)
    self.hint=text(360,1055,"Jump the stone • slide the arch • strike the ward",18)
    self.action=text(360,558,"READY",18,"ui","hud",GOLD)
    self.buttons={}
    local function button(x,y,w,label,action,layer)
        local n=box(x,y,w,65,"panel",layer or "hud",INK)
        local labelnode=text(x,y,label,22,"ui",layer or "hud",GOLD)
        self.buttons[#self.buttons+1]={node=n,action=action}
        return n,labelnode
    end
    button(74,104,104,"LEFT","left")
    button(196,104,104,"RIGHT","right")
    button(357,104,142,"JUMP","jump")
    button(518,104,142,"SLIDE","slide")
    button(649,104,94,"HIT","attack")
    button(626,1075,110,"PAUSE","pause")
    text(360,42,"Swipe to move  /  Up: jump  /  Down: slide",18)
    self.overlay={}
    self.overlay[#self.overlay+1]=box(360,742,640,270,"panel","overlay",color(.04,.07,.14,.94))
    self.title=text(360,824,"MYSTICRUN",47,"title","overlay",GOLD)
    self.overlay[#self.overlay+1]=self.title
    self.subtitle=text(360,774,"KNIGHT  /  DEFOLD TRIAL",18,"ui","overlay")
    self.overlay[#self.overlay+1]=self.subtitle
    self.detail=text(360,729,"One hero. Three lanes. A new engine.",20,"ui","overlay")
    self.overlay[#self.overlay+1]=self.detail
    self.startbutton,self.starttext=button(360,663,270,"BEGIN RUN","start","overlay")
    self.overlay[#self.overlay+1]=self.startbutton
    self.overlay[#self.overlay+1]=self.starttext
    bridge(self,"ready")
end
local function draw(self)
    local s=self.s
    local road_offset=s.distance%1.5
    for i,n in ipairs(self.road) do
        local z=(i-8)*1.5-road_offset
        local y,w=projection(z)
        local y2,w2=projection(z+1.5)
        gui.set_position(n,vmath.vector3(360,(y+y2)/2,0))
        gui.set_size(n,vmath.vector3((w+w2)/2,math.abs(y-y2)+1.5,0))
        local tile=(math.floor(s.distance/1.5)+i)%32
        gui.play_flipbook(n,string.format("strip_%02d",tile))
        gui.set_color(n,color(.72+.28/(1+z*.02),.76+.24/(1+z*.02),.90,1))
    end
    for i,pair in ipairs(self.rails) do
        local z=(i-3)*4-s.distance%4
        local y,w,p=projection(z)
        for side,n in ipairs(pair) do
            gui.set_position(n,vmath.vector3(360+(side==1 and -1 or 1)*w*.52,y+18*p,0))
            gui.set_size(n,vmath.vector3(38*p,98*p,0))
            gui.set_color(n,color(.85,.87,1,math.min(1,p*2)))
        end
    end
    local ordered={}
    for _,o in ipairs(s.objects) do
        local ahead=o.z-s.distance
        if ahead>-5 and ahead<135 and not o.done then ordered[#ordered+1]=o end
    end
    table.sort(ordered,function(a,b) return a.z>b.z end)
    for i,n in ipairs(self.pool) do
        local o=ordered[i]
        gui.set_enabled(n,o~=nil)
        if o then
            local y,w,p=projection(o.z-s.distance)
            local x=360+o.lane*w*.205
            local size=(o.kind=="coin" and 46 or 128)*p
            gui.play_flipbook(n,o.kind)
            gui.set_size(n,vmath.vector3(size,(o.kind=="arch" and 190 or o.kind=="hurdle" and 105 or 128)*p,0))
            gui.set_position(n,vmath.vector3(x,y+(o.kind=="coin" and 52 or o.kind=="arch" and 76 or 42)*p,0))
            if o.kind=="coin" then
                gui.set_scale(n,vmath.vector3(.58+.42*math.abs(math.sin(s.time*3+o.z)),1,1))
            else gui.set_scale(n,vmath.vector3(1,1,1)) end
        end
    end
    local x=360+s.x*172
    gui.set_position(self.shadow,vmath.vector3(x,260,0))
    gui.set_scale(self.shadow,vmath.vector3(1-s.height*.13,1-s.height*.13,1))
    knight.update(self.actor,s,x,260+s.height*108)
    for i,n in ipairs(self.particles) do
        local a=i*2.399+s.time*.2
        local py=(i*71+s.time*(11+i%4))%880+230
        gui.set_position(n,vmath.vector3(360+math.sin(a)*310,py,0))
        gui.set_color(n,color(1,.86,.49,.25+.35*math.abs(math.sin(s.time+i))))
    end
    gui.set_text(self.distance,string.format("%d m",math.floor(s.distance)))
    gui.set_text(self.coins,string.format("%d relics",s.coins))
    gui.set_text(self.health,string.format("%d / 3",s.hp))
    local state=s.mode~="running" and s.mode:upper() or s.hurt>0 and "RECOVER"
        or s.height>0 and (s.vy>0 and "JUMP" or "FALL")
        or s.slide>0 and "SLIDE" or s.land>0 and "LAND"
        or s.attack>0 and "STRIKE" or "RUN"
    gui.set_text(self.action,state)
    local cue="Follow the relics, or challenge the centre lane."
    for _,o in ipairs(s.objects) do
        local ahead=o.z-s.distance
        if o.kind~="coin" and ahead>0 and ahead<30 then
            cue=o.kind=="hurdle" and "STONE HURDLE  /  JUMP OR CHANGE LANE"
                or o.kind=="arch" and "LOW ARCH  /  SLIDE OR CHANGE LANE"
                or "CRYSTAL WARD  /  STRIKE OR CHANGE LANE"
            break
        end
    end
    gui.set_text(self.hint,cue)
    local overlay=s.mode~="running"
    for _,n in ipairs(self.overlay) do gui.set_enabled(n,overlay) end
    if overlay then
        gui.set_text(self.title,s.mode=="ready" and "MYSTICRUN" or s.mode=="paused" and "TAKE A BREATH" or "RUN COMPLETE")
        gui.set_text(self.subtitle,s.mode=="ready" and "KNIGHT  /  DEFOLD TRIAL" or string.format("%d METRES  /  %d RELICS",s.distance,s.coins))
        gui.set_text(self.detail,s.mode=="defeat" and "Three hits. Try another route." or "Touch buttons or swipe. Keyboard supported.")
        gui.set_text(self.starttext,s.mode=="ready" and "BEGIN RUN" or s.mode=="paused" and "RESUME" or "TRY AGAIN")
    end
end
function update(self,dt)
    if self.smoke then return end
    self.frames=self.frames+1;self.frame_total=self.frame_total+dt
    self.max_frame=math.max(self.max_frame,dt)
    if self.web then
        local c=html5.run("(function(){var q=window.__MR_COMMANDS||[];return q.shift()||''})()")
        if c and c~="" then command(self,c) end
    end
    runner.step(self.s,dt)
    draw(self)
    self.report=self.report+dt
    if self.report>.15 then self.report=0;bridge(self) end
end
function on_input(self,id,action)
    if self.smoke then return end
    if id==hash("touch") then
        if action.pressed then
            for _,b in ipairs(self.buttons) do
                if gui.is_enabled(b.node,true) and gui.pick_node(b.node,action.x,action.y) then
                    local c=b.action
                    if c=="start" then
                        c=self.s.mode=="paused" and "resume" or self.s.mode=="defeat" and "restart" or "start"
                    end
                    command(self,c);self.touch=nil;return true
                end
            end
            self.touch={x=action.x,y=action.y}
        elseif action.released and self.touch then
            local dx,dy=action.x-self.touch.x,action.y-self.touch.y
            if math.max(math.abs(dx),math.abs(dy))>28 then
                command(self,math.abs(dx)>math.abs(dy) and (dx>0 and "right" or "left")
                    or (dy>0 and "jump" or "slide"))
            end
            self.touch=nil
        end
        return true
    end
    if action.pressed then
        for _,name in ipairs({"left","right","jump","slide","attack","pause","start","restart"}) do
            if id==hash(name) then command(self,name);return true end
        end
    end
end
