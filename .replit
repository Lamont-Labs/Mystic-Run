modules = ["python-3.12"]

[nix]
channel = "stable-25_05"
packages = ["blender", "freetype", "lcms2", "libglvnd", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "mesa", "openjpeg", "tcl", "tk", "xorg.libX11", "xorg.libXcursor", "xorg.libXi", "xorg.libXinerama", "xorg.libXrandr", "xorg.libXxf86vm", "xorg.xorgserver", "zlib"]

[agent]
expertMode = true
