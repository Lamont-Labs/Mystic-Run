modules = ["python-3.12", "dotnet-8.0", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["blender", "freetype", "gitFull", "lcms2", "libglvnd", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "mesa", "openjpeg", "playwright-driver", "tcl", "tk", "xorg.libX11", "xorg.libXcursor", "xorg.libXi", "xorg.libXinerama", "xorg.libXrandr", "xorg.libXxf86vm", "xorg.xorgserver", "zlib", "chromium"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000
